generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  MEMBER
  AUDITOR
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model Organization {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(64)
  name String @db.VarChar(160)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  memberships Membership[]
  projects Project[]
  invitations Invitation[]
  teams Team[]
  @@map("organizations")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(320)
  passwordHash String @map("password_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  memberships Membership[]
  assignedTasks Task[] @relation("TaskAssignee")
  sessions Session[]
  notifications Notification[]
  teamMemberships TeamMember[]
  @@map("users")
}

model Membership {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role Role @default(MEMBER)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  refreshTokenHash String @unique @map("refresh_token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}

model Invitation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  email String @db.VarChar(320)
  role Role @default(MEMBER)
  tokenHash String @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, email])
  @@map("invitations")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(160)
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  tasks Task[]
  @@index([organizationId, createdAt])
  @@map("projects")
}

model Milestone {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  name String @db.VarChar(160)
  dueAt DateTime? @map("due_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks Task[]
  @@map("milestones")
}

model Task {
  id String @id @default(uuid()) @db.Uuid
  projectId String @map("project_id") @db.Uuid
  milestoneId String? @map("milestone_id") @db.Uuid
  assigneeId String? @map("assignee_id") @db.Uuid
  title String @db.VarChar(200)
  description String? @db.Text
  status TaskStatus @default(TODO)
  version Int @default(1)
  dueAt DateTime? @map("due_at")
  parentId String? @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  parent Task? @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[] @relation("TaskHierarchy")
  comments Comment[]
  activities Activity[]
  attachments Attachment[]
  @@index([projectId, status])
  @@index([parentId])
  @@map("tasks")
}

model Attachment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @map("task_id") @db.Uuid
  filename String @db.VarChar(255)
  contentType String @map("content_type") @db.VarChar(127)
  storageKey String @unique @map("storage_key") @db.VarChar(512)
  sizeBytes Int @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId])
  @@map("attachments")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  eventKey String @unique @map("event_key") @db.VarChar(128)
  channel String @db.VarChar(32)
  payload Json
  sentAt DateTime? @map("sent_at")
  failedAt DateTime? @map("failed_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@map("notifications")
}

model Job {
  id String @id @default(uuid()) @db.Uuid
  idempotencyKey String @unique @map("idempotency_key") @db.VarChar(128)
  type String @db.VarChar(64)
  payload Json
  attempts Int @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  completedAt DateTime? @map("completed_at")
  failedAt DateTime? @map("failed_at")
  lastError String? @map("last_error") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  @@index([completedAt, availableAt])
  @@map("jobs")
}

model WebhookEvent {
  id String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(64)
  externalId String @map("external_id") @db.VarChar(255)
  payload Json
  receivedAt DateTime @default(now()) @map("received_at")
  @@unique([provider, externalId])
  @@map("webhook_events")
}

model Comment {
  id String @id @default(uuid()) @db.Uuid
  taskId String @map("task_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body String @db.VarChar(4000)
  createdAt DateTime @default(now()) @map("created_at")
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
  @@map("comments")
}

model Activity {
  id String @id @default(uuid()) @db.Uuid
  taskId String @map("task_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(64)
  payload Json
  createdAt DateTime @default(now()) @map("created_at")
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@index([taskId, createdAt])
  @@map("activities")
}

model Team {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  name String @db.VarChar(160)
  description String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members TeamMember[]
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id String @id @default(uuid()) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}
