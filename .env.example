# Copy this file to .env and replace development-only placeholders locally.
POSTGRES_DB=worksphere
POSTGRES_USER=worksphere
POSTGRES_PASSWORD=change-me-before-sharing
DATABASE_URL=postgresql://worksphere:change-me-before-sharing@postgres:5432/worksphere?schema=public
REDIS_URL=redis://redis:6379
API_PORT=4000
ANALYTICS_PORT=8000
ANALYTICS_SERVICE_TOKEN=replace-with-a-private-service-token
AUTH_SECRET=replace-with-a-unique-32-character-minimum-local-secret
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

